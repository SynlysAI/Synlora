# 存储：mongodb | sqlite（默认 sqlite，开发零依赖）
STORAGE_BACKEND=sqlite
MONGODB_URI=
MONGODB_DB=synlys_agent
SQLITE_PATH=../data/synlys_agent.db

# 认证（与 AI4MS 共享）：AUTH_SECRET 与门户一致；DEV_AUTH_TOKEN 为 sqlite 开发模式的本地 token
AUTH_SECRET=
AUTH_ENABLED=true
DEV_AUTH_TOKEN=

# 服务
HOST=0.0.0.0
PORT=8005
DATA_DIR=../data

# http.request 工具域名白名单（逗号分隔；空 = 全拒）
HTTP_ALLOWED_HOSTS=

# 加密 key（Fernet key，用于 provider api_key 加密；生成：python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"）
FERNET_KEY=

# 用户工作区配额（字节）
USER_QUOTA_BYTES=1073741824

# WeKnora 知识库服务（knowledge.list / knowledge.search 工具；空 = 未接入，工具报未配置）
WEKNORA_BASE_URL=
WEKNORA_API_KEY=

# SearXNG 联网搜索（web.search 工具；地址空 = 未启用，工具报未配置）
ASSISTANT_WEB_SEARCH_ENDPOINT=
# 如果 SearXNG 实例配了 API Key 才需要，否则留空
ASSISTANT_WEB_SEARCH_API_KEY=

# python.run 沙箱执行形态：local（默认，本机 -I 子进程）| docker（临时容器强隔离）
# docker 模式前置：docker build -t synlora-sandbox:latest docker/sandbox/
SANDBOX_MODE=local
SANDBOX_DOCKER_IMAGE=synlora-sandbox:latest
# docker 不可用时：false = 回退本机执行（事件标 sandbox=local-weak）；true = 拒绝执行（多用户部署建议）
SANDBOX_STRICT=false
# 单容器资源限额
SANDBOX_MEM_LIMIT=512m
SANDBOX_CPUS=1.0
SANDBOX_PIDS_LIMIT=256
# 容器内运行用户（空 = 镜像默认非 root 用户 sandbox）
SANDBOX_DOCKER_USER=
# 后台沙箱任务独立超时（秒）：默认值必须为有限正数且不超过最大值
SANDBOX_JOB_DEFAULT_TIMEOUT_S=1800
SANDBOX_JOB_MAX_TIMEOUT_S=7200
# 部署命名空间：空时按规范化 DATA_DIR 的 SHA-256 前 16 位稳定派生
SANDBOX_DEPLOYMENT_ID=
